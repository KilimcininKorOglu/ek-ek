# Copy this file to .env and fill in the values.
#
# .env is never committed. The repository is public from the first commit, and
# a leaked secret cannot be taken back, so no credential belongs in a tracked
# file even when it only guards a development box.

# Administrator account created when the development cluster is bootstrapped.
EK_EK_ADMIN_USER=admin
EK_EK_ADMIN_PASSWORD=

# The host account that owns docker-data. `make dev-up` fills these in when the
# file is generated, so an explicit value is only needed to override them.
HOST_UID=
HOST_GID=
